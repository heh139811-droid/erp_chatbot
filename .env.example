PORT=3000
HOST=127.0.0.1
DATABASE_URL=
PGLITE_DATA_DIR=.data/chat
# DB 세션 시간대. timestamptz 저장은 절대 시각 그대로이고, 오프셋 없는 입력 해석과 표기만 바뀝니다.
DB_TIME_ZONE=Asia/Seoul
# 보존 기간이 지난 데이터를 지우는 주기(ms). 0 이면 내부 타이머를 띄우지 않습니다.
CLEANUP_INTERVAL_MS=86400000
CHAT_PROVIDER=claude-cli
CLAUDE_COMMAND=claude
CLAUDE_MODEL=sonnet
CHAT_CONTEXT_MAX_TOKENS=200000
DEV_USER_ID=00000000-0000-4000-8000-000000000001
CRM_MYSQL_ENABLED=true
CRM_MYSQL_HOST=127.0.0.1
CRM_MYSQL_PORT=3306
CRM_MYSQL_DATABASE=crm
CRM_MYSQL_USER=root
CRM_MYSQL_PASSWORD=
CRM_MYSQL_CONNECTION_LIMIT=5
